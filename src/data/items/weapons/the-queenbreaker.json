  "magazine": "$quantum[heavies-linear-fusion-rifle-the-queenbreaker-combat-sights].timing.magazine",
  "totalShots": "$quantum[heavies-linear-fusion-rifle-the-queenbreaker-combat-sights].timing.totalShots",
  "reloadTimeMs": "$aegisSustained[the-queenbreaker-rewind-rounds-combat-sights].timing.reloadTimeMs",
  "catalyst": {
    "name": "Rewind Rounds, The Queenbreaker Catalyst",
    "description": "Grants the Rewind Rounds trait:\nUpon emptying the Magazine:\nRefills 60% of the number of Hits landed (rounded up) into the Magazine from reserves.\nHits are counted from either your last reload or the last time the perk was triggered. Does not require Direct Hits.\nRequires firing 28.75% of the Magazine Capacity for the refill to activate.\nCannot load the Magazine beyond its base capacity.\nHits after triggering a refill do not count while the Rewind Rounds buff is active (1? second).\nAdaptive Burst Linear Fusion Rifle behavior:\n• Each individual bolt in the burst counts as a Hit\n• Refill amount is uniquely 14% of the number of Hits rounded up (numbers are subject to change once we get more data points)",
    "effect": "timing",
    "timing": {
      "fireRateRpm": "$aegisSustained[the-queenbreaker-rewind-rounds-combat-sights].timing.fireRateRpm",
      "magazine": "$aegisSustained[the-queenbreaker-rewind-rounds-combat-sights].timing.magazine",
      "totalShots": "$aegisSustained[the-queenbreaker-rewind-rounds-combat-sights].timing.totalShots",
      "reloadTimeMs": "$aegisSustained[the-queenbreaker-rewind-rounds-combat-sights].timing.reloadTimeMs"
    }
  },
  "playstyles": [
    { "id": "combat-sights", "label": "Combat Sights" },
    { "id": "marksman-sights", "label": "Marksman Sights" }
  ],
  "parts": {
    "shot": {
      "name": "Burst, Combat Sights",
      "damage": "$aegis[linear-fusion-rifle-the-queenbreaker-burst-combat-sights].perShot",
      "delivery": "impact"
    },
    "shot-marksman": {
      "name": "Bolt, Marksman Sights",
      "damage": "$aegis[linear-fusion-rifle-the-queenbreaker-marksman-sights].perShot",
      "delivery": "impact"
    }
  },
  "rules": [
    {
      "id": "shot",
      "on": { "on": "shot" },
      "if": [{ "type": "playstyle", "id": "marksman-sights", "not": true }],
      "do": [{ "type": "spawn", "part": "shot" }]
    },
    {
      "id": "shot-marksman",
      "on": { "on": "shot" },
      "if": [{ "type": "playstyle", "id": "marksman-sights" }],
      "do": [{ "type": "spawn", "part": "shot-marksman" }]
    },
    {
      "id": "rate-marksman",
      "on": { "on": "phaseStart" },
      "if": [{ "type": "playstyle", "id": "marksman-sights" }],
      "do": [
        {
          "type": "modifyStat",
          "modifier": {
            "type": "stat",
            "stat": "rpm",
            "value": "$aegisSustained[the-queenbreaker-rewind-rounds-marksman-sights].timing.fireRateRpm"
          }
        }
      ]
    }
  ]
