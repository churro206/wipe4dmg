{
  "id": "the-queenbreaker",
  "kind": "exoticWeapon",
  "name": "The Queenbreaker",
  "texts": [
    { "source": "clarity", "entry": "Wire Rifle", "hash": "81f813f3" },
    { "source": "clarity", "entry": "The Queenbreaker Catalyst", "hash": "5e11df5a" }
