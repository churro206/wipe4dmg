  "catalyst": {
    "name": "Burning Ambition, The Lament Catalyst",
    "description": "Direct Hits against Scorched Enemies apply 20 additional Scorch (30 with Ember of Ashes) on a 0.5 second cooldown\nScoring 3 Direct Hits within 3? seconds of each causes the next Direct Hit to Scorch the target. This allows The Lament to Scorch through a singular revved attack.\nHit counter persists through stow.\nScorch applied by Burning Ambition to Unscorched targets counts as Weapon Damage, and thus, triggers Revved Consumption's healing, granting 7HP per tick.",
    "effect": "damage"
  },
  "playstyles": [
    { "id": "2l1h1r", "label": "2L1H1R" },
    { "id": "2l1h", "label": "2L1H" },
    { "id": "3l1h1r", "label": "3L1H1R" },
    { "id": "4l1h1r", "label": "4L1H1R" }
  ],
  "parts": {
