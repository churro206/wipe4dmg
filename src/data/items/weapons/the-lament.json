        { "type": "playstyle", "id": "4l1h1r", "not": true }
      ],
      "do": [{ "type": "spawn", "part": "combo" }]
    },
    {
      "id": "shot-2l1h",
      "on": { "on": "shot" },
      "if": [{ "type": "playstyle", "id": "2l1h" }],
      "do": [{ "type": "spawn", "part": "combo-2l1h" }]
    },
    {
      "id": "shot-3l1h1r",
      "on": { "on": "shot" },
      "if": [{ "type": "playstyle", "id": "3l1h1r" }],
      "do": [{ "type": "spawn", "part": "combo-3l1h1r" }]
    },
    {
      "id": "shot-4l1h1r",
      "on": { "on": "shot" },
      "if": [{ "type": "playstyle", "id": "4l1h1r" }],
      "do": [{ "type": "spawn", "part": "combo-4l1h1r" }]
    },
    {
      "id": "rate-2l1h",
      "on": { "on": "phaseStart" },
      "if": [{ "type": "playstyle", "id": "2l1h" }],
      "do": [
        {
          "type": "modifyStat",
          "modifier": {
            "type": "stat",
            "stat": "rpm",
            "value": {
              "expr": "60 / $aegisSustained[the-lament-2l1h-combo-lucent-blades-x3-burning-ambition-argent-blade-solar-fulmination].peakRateSeconds",
              "note": "seconds per combo to combos per minute"
            }
          }
        }
      ]
    },
    {
      "id": "rate-3l1h1r",
      "on": { "on": "phaseStart" },
      "if": [{ "type": "playstyle", "id": "3l1h1r" }],
      "do": [
        {
          "type": "modifyStat",
          "modifier": {
            "type": "stat",
            "stat": "rpm",
            "value": {
              "expr": "60 / $aegisSustained[the-lament-3l1h1r-combo-lucent-blades-x3-burning-ambition-combination-argent-blade-sword-storm-combo].peakRateSeconds",
              "note": "seconds per combo to combos per minute"
            }
          }
        }
      ]
