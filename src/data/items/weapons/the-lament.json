    {
      "id": "rate-4l1h1r",
      "on": { "on": "phaseStart" },
      "if": [{ "type": "playstyle", "id": "4l1h1r" }],
      "do": [
        {
          "type": "modifyStat",
          "modifier": {
            "type": "stat",
            "stat": "rpm",
            "value": {
              "expr": "60 / $aegisSustained[the-lament-4l1h1r-combo-lucent-blades-x3-burning-ambition-combination-argent-blade-sword-storm-combo].peakRateSeconds",
              "note": "seconds per combo to combos per minute"
            }
          }
        }
      ]
    },
    {
      "id": "burning-ambition",
      "on": { "on": "hit" },
      "if": [{ "type": "hasItem", "id": "catalyst" }],
      "do": [
        {
          "type": "applyStatus",
          "status": "scorch",
          "stacks": {
            "expr": "$clarity[The Lament Catalyst](\"apply 20 additional Scorch\") * 6",
            "note": "20 Scorch per Direct Hit, one per 0.5 s cooldown; a combo of about 3 s has 6 hits (Aegis row 2L1H1R, 6 shots)"
          }
        }
      ]
