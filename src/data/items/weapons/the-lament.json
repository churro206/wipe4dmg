      "name": "Combo 2L1H",
      "damage": {
        "expr": "$aegis[sword-the-lament-average-2l1h-burning-ambition].perShot / 1.1134",
        "note": "Aegis measures this combo only with Burning Ambition; the catalyst's share (5077.945 / 4560.949 of the pair 2L1H1R, with and without) is taken out, the catalyst itself comes as Scorch"
      },
      "delivery": "impact"
    },
    "combo-3l1h1r": {
      "name": "Combo 3L1H1R",
      "damage": {
        "expr": "$aegis[sword-the-lament-average-3l1h1r-burning-ambition].perShot / 1.1134",
        "note": "as 2L1H: the catalyst's share of the pair 2L1H1R is taken out"
      },
      "delivery": "impact"
    },
    "combo-4l1h1r": {
      "name": "Combo 4L1H1R",
      "damage": {
        "expr": "$aegis[sword-the-lament-average-4l1h1r-burning-ambition].perShot / 1.1134",
        "note": "as 2L1H: the catalyst's share of the pair 2L1H1R is taken out"
      },
      "delivery": "impact"
    }
