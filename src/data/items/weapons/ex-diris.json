    "name": "Ex Diris Catalyst",
    "description": "Weapon Kills grant Amplified for 15 seconds.\nWhile Amplified, Direct Hits charge Enrage twice as fast (25%🠚50% per hit).",
    "effect": "none"
  },
  "parts": {
    "shot": {
      "name": "Arc projectile",
      "damage": "$quantum[specials-grenade-launcher-ex-diris-no-enrage].bodyDamage",
      "delivery": "impact"
    },
    "moth": {
      "name": "Hive Moth",
      "damage": "$clarity[Loyal Moths](\"deal 525\")",
      "delivery": "splash"
    }
  },
  "rules": [
    {
      "id": "shot",
      "on": { "on": "shot" },
      "do": [{ "type": "spawn", "part": "shot" }]
    },
    {
      "id": "enrage-max",
      "on": { "on": "hit", "part": "shot" },
      "if": [
        {
          "type": "counter",
          "id": "enrage",
          "op": "=",
          "value": {
            "expr": "100 / $clarity[Corrupted Nucleosynthesis](\"Each Direct Hit grants 25%\") - 1",
            "note": "100 % progress at 25 % per hit: the 4th hit; the counter stands one lower"
          }
        }
      ],
      "do": [
        {
          "type": "modifyStat",
          "modifier": {
            "type": "stat",
            "stat": "rpm",
            "value": "$quantum[specials-grenade-launcher-ex-diris-max-enrage].rpm"
          }
        }
      ]
    },
    {
      "id": "enrage-count",
      "on": { "on": "hit", "part": "shot" },
      "if": [
        {
          "type": "counter",
          "id": "enrage",
          "op": "<",
          "value": {
            "expr": "100 / $clarity[Corrupted Nucleosynthesis](\"Each Direct Hit grants 25%\")",
            "note": "hits to 100 % progress"
          }
        }
      ],
      "do": [{ "type": "addStacks", "counter": "enrage" }]
    },
    {
      "id": "moth-count",
      "on": { "on": "hit", "part": "shot" },
      "if": [
        {
          "type": "counter",
          "id": "moth",
          "op": "<",
          "value": {
            "expr": "$clarity[Loyal Moths](\"2 Direct Hits\") - 1",
            "note": "the counter stands at 0 for the hits before the 2nd"
          }
        }
      ],
      "do": [{ "type": "addStacks", "counter": "moth" }]
    },
    {
      "id": "moth",
      "on": { "on": "hit", "part": "shot" },
      "if": [
        {
          "type": "counter",
          "id": "moth",
          "op": "=",
          "value": {
            "expr": "$clarity[Loyal Moths](\"2 Direct Hits\") - 1",
            "note": "the 2nd direct hit"
          }
        }
      ],
      "do": [
        { "type": "resetCounter", "counter": "moth" },
        { "type": "spawn", "part": "moth" }
      ],
      "cooldownMs": {
        "expr": "$clarity[Loyal Moths](\"3 second cooldown\") * 1000",
        "note": "seconds to milliseconds"
      }
    }
  ],
