  "rules": [
    {
      "id": "shot",
      "on": { "on": "shot" },
      "do": [{ "type": "spawn", "part": "shot" }]
    },
    {
      "id": "soul-devourer-up",
      "on": { "on": "shot" },
      "if": [
        { "type": "playstyle", "id": "pre-stacked" },
        {
          "type": "counter",
          "id": "soul-devourer-started",
          "op": "<",
          "value": {
            "value": 1,
            "source": {
              "name": "Item file thorn",
              "retrieved": "2026-11-03",
              "status": "derived",
              "quote": "Collecting a Remnant grants 'Soul Devourer' for 7 seconds and refills 4 ammo.",
              "note": "Derived: the playstyle \"pre-stacked\" (Remnants collected before the phase, Soul Devourer persists through stow); the window opens once, with the first shot"
            }
          }
        }
      ],
      "do": [
        { "type": "addStacks", "counter": "soul-devourer-started" },
        {
          "type": "setMode",
          "mode": "soul-devourer",
          "to": "on",
          "durationMs": {
            "expr": "$clarity[Soul Devourer](\"extending the duration up to 11 seconds\") * 1000",
            "note": "seconds to milliseconds; several Remnants collected before the phase give the longest window"
          }
        }
      ]
    },
    {
      "id": "corruption",
      "on": { "on": "hit", "part": "shot" },
      "if": [{ "type": "mode", "id": "soul-devourer", "is": "on", "not": true }],
      "do": [
        {
          "type": "spawn",
          "part": "corruption",
          "delayMs": {
            "expr": "$clarity[Mark of the Devourer](\"every 0.5 seconds\") * 1000",
            "note": "the first tick one interval after the hit, seconds to milliseconds"
          },
          "count": {
            "expr": "$clarity[Mark of the Devourer](\"for 2 seconds\") / $clarity[Mark of the Devourer](\"every 0.5 seconds\")",
            "note": "duration divided by the interval"
          },
          "intervalMs": {
            "expr": "$clarity[Mark of the Devourer](\"every 0.5 seconds\") * 1000",
            "note": "seconds to milliseconds"
          }
        }
      ]
    },
    {
      "id": "corruption-soul-devourer",
      "on": { "on": "hit", "part": "shot" },
      "if": [{ "type": "mode", "id": "soul-devourer", "is": "on" }],
      "do": [
        {
          "type": "spawn",
          "part": "corruption",
          "delayMs": {
            "expr": "$clarity[Mark of the Devourer](\"every 0.5 seconds\") * 1000",
            "note": "the first tick one interval after the hit, seconds to milliseconds"
          },
          "count": {
            "expr": "$clarity[Mark of the Devourer](\"for 2 seconds\") / $clarity[Mark of the Devourer](\"every 0.5 seconds\")",
            "note": "duration divided by the interval"
          },
          "intervalMs": {
            "expr": "$clarity[Mark of the Devourer](\"every 0.5 seconds\") * 1000",
            "note": "seconds to milliseconds"
          },
          "factor": {
            "expr": "1 + $clarity[Soul Devourer](\"increases poison damage by 200%\") / 100",
            "note": "percent to factor"
          }
        }
      ]
    }
  ],
