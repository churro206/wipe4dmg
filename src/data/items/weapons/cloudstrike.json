    { "source": "clarity", "entry": "Cloudstrike Catalyst", "hash": "be2bb0e1" },
    { "source": "clarity", "entry": "Mortal Polarity", "hash": "9ff5c1f8" },
    { "source": "clarity", "entry": "Stormbringer", "hash": "a551405b" }
  ],
  "chargeTimeMs": {
    "value": 0,
    "source": {
      "name": "Item file cloudstrike",
      "retrieved": "2026-11-03",
      "status": "derived",
      "note": "Derived: the weapon has no charge of its own; the Quantum time to empty counts from the first shot"
    }
  },
  "fireRateRpm": "$quantum[specials-sniper-rifle-cloudstrike].timing.fireRateRpm",
  "magazine": "$quantum[specials-sniper-rifle-cloudstrike].timing.magazine",
  "totalShots": "$quantum[specials-sniper-rifle-cloudstrike].timing.totalShots",
  "reloadTimeMs": "$quantum[specials-sniper-rifle-cloudstrike].timing.reloadTimeMs",
  "catalyst": {
    "name": "Triple Tap, Cloudstrike Catalyst",
    "description": "Passively grants 25 Handling.\nGrants the Triple Tap trait:\nScoring 3 Precision Hits within 2 seconds of each refills 1 Ammo into the Magazine from thin air.\nCannot load the Magazine beyond its base capacity. Precision Hit counter persists through stow.",
    "effect": "timing",
    "timing": {
      "fireRateRpm": "$quantum[specials-sniper-rifle-cloudstrike-cata].timing.fireRateRpm",
      "magazine": "$quantum[specials-sniper-rifle-cloudstrike-cata].timing.magazine",
      "totalShots": "$quantum[specials-sniper-rifle-cloudstrike-cata].timing.totalShots",
      "reloadTimeMs": "$quantum[specials-sniper-rifle-cloudstrike-cata].timing.reloadTimeMs"
    }
  },
  "parts": {
    "shot": {
      "name": "Shot",
      "damage": "$quantum[specials-sniper-rifle-cloudstrike].precisionDamage",
      "precision": true,
      "delivery": "impact"
    },
    "strike": {
      "name": "Lightning strike",
      "damage": {
        "expr": "($quantum[specials-sniper-rifle-cloudstrike].magDamage - $quantum[specials-sniper-rifle-cloudstrike].magazine * $quantum[specials-sniper-rifle-cloudstrike].precisionDamage) / 2 * $clarity[Stormbringer](\"dealing 973\") / ($clarity[Stormbringer](\"dealing 973\") + $clarity[Stormbringer](\"dealing 584\"))",
        "note": "ADR 0019: Quantum's magazine minus its shots is the strikes of 2 series (7 precision hits = 2 series of 3), 969 each; split in the ratio of Clarity's 973 : 584"
      },
      "delivery": "splash"
    },
    "storm": {
      "name": "Lightning storm",
      "damage": {
        "expr": "($quantum[specials-sniper-rifle-cloudstrike].magDamage - $quantum[specials-sniper-rifle-cloudstrike].magazine * $quantum[specials-sniper-rifle-cloudstrike].precisionDamage) / 2 * $clarity[Stormbringer](\"dealing 584\") / ($clarity[Stormbringer](\"dealing 973\") + $clarity[Stormbringer](\"dealing 584\"))",
        "note": "ADR 0019: as the strike, the share of the storm in 969 per series"
      },
      "delivery": "splash"
    }
  },
  "rules": [
    {
      "id": "shot",
      "on": { "on": "shot" },
      "do": [{ "type": "spawn", "part": "shot" }]
    },
    {
      "id": "storm-count",
      "on": { "on": "hit", "part": "shot", "precision": true },
      "if": [
        {
          "type": "counter",
          "id": "stormbringer",
          "op": "<",
          "value": {
            "expr": "$clarity[Stormbringer](\"On 3 Precision Hits\") - 1",
            "note": "the counter stands at 0 to 1 for the hits before the 3rd"
          }
        }
      ],
      "do": [{ "type": "addStacks", "counter": "stormbringer" }]
    },
    {
      "id": "storm",
      "on": { "on": "hit", "part": "shot", "precision": true },
      "if": [
        {
          "type": "counter",
          "id": "stormbringer",
          "op": "=",
          "value": {
            "expr": "$clarity[Stormbringer](\"On 3 Precision Hits\") - 1",
            "note": "the 3rd precision hit"
          }
        }
      ],
      "do": [
        { "type": "resetCounter", "counter": "stormbringer" },
        {
          "type": "spawn",
          "part": "strike",
          "delayMs": {
            "expr": "$clarity[Stormbringer](\"after 1.1 seconds\") * 1000",
            "note": "seconds to milliseconds"
          }
        },
        {
          "type": "spawn",
          "part": "storm",
          "delayMs": {
            "expr": "($clarity[Stormbringer](\"after 1.1 seconds\") + $clarity[Stormbringer](\"0.5 seconds later\")) * 1000",
            "note": "the storm comes 0.5 s after the strike, seconds to milliseconds"
          }
        }
      ]
    },
    {
      "id": "bolt-charge",
      "on": { "on": "hit", "part": "strike" },
      "do": [
        {
          "type": "applyStatus",
          "status": "boltCharge",
          "stacks": "$clarity[Stormbringer](\"Grants x1 Bolt Charge\")"
        }
      ]
    }
  ],
  "notModelled": [
    { "quote": "Passively grants 25 Handling", "reason": "no damage against a boss" },
    {
      "quote": "Scoring 3 Precision Hits within 2 seconds",
      "reason": "needs nothing more (Quantum's row cata carries the refill as magazine and ammo)"
    },
    {
      "quote": "Precision Kills summon a lightning strike",
      "reason": "no adds (ADR 0015)"
    },
    {
      "quote": "deals 0% damage at the edge of its radius",
      "reason": "below 2 %"
    },
    {
      "quote": "deals 25% damage at the edge of its radius",
      "reason": "below 2 %"
    }
  ]
}
