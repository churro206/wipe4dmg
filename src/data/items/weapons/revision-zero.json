  "rules": [
    {
      "id": "shot",
      "on": { "on": "shot" },
      "do": [{ "type": "spawn", "part": "shot" }]
    },
    {
      "id": "targeting-data-count",
      "on": { "on": "hit", "part": "shot", "precision": true },
      "if": [
        {
          "type": "counter",
          "id": "targeting-hits",
          "op": "<",
          "value": { "expr": "$clarity[Hunter's Trace](\"Scoring 12 Precision Hits\") - 1", "note": "the counter stands at 0 to 10 for the precision hits before the 12th" }
        }
      ],
      "do": [{ "type": "addStacks", "counter": "targeting-hits" }]
    },
    {
      "id": "targeting-data-charge",
      "on": { "on": "hit", "part": "shot", "precision": true },
      "if": [
        {
          "type": "counter",
          "id": "targeting-hits",
          "op": "=",
          "value": { "expr": "$clarity[Hunter's Trace](\"Scoring 12 Precision Hits\") - 1", "note": "the 12th precision hit" }
        },
        {
          "type": "counter",
          "id": "targeting-charges",
          "op": "<",
          "value": { "expr": "$clarity[Hunter's Trace](\"Maximum of 4 charges\") - 1", "note": "the counter stands at 0 to 2 for the charges before the 4th" }
        }
      ],
      "do": [
        { "type": "resetCounter", "counter": "targeting-hits" },
        { "type": "addStacks", "counter": "targeting-charges" }
      ]
    },
    {
      "id": "targeting-data-release",
      "on": { "on": "hit", "part": "shot", "precision": true },
      "if": [
        {
          "type": "counter",
          "id": "targeting-hits",
          "op": "=",
          "value": { "expr": "$clarity[Hunter's Trace](\"Scoring 12 Precision Hits\") - 1", "note": "the 12th precision hit" }
        },
        {
          "type": "counter",
          "id": "targeting-charges",
          "op": "=",
          "value": { "expr": "$clarity[Hunter's Trace](\"Maximum of 4 charges\") - 1", "note": "the 4th charge: all of them are converted" }
        }
      ],
      "do": [
        { "type": "resetCounter", "counter": "targeting-hits" },
        { "type": "resetCounter", "counter": "targeting-charges" },
        {
          "type": "spawn",
          "part": "sniper",
          "count": "$clarity[Hunter's Trace](\"Maximum of 4 charges\")",
          "factor": {
            "expr": "1 - (60 / $clarity[Hunter's Trace](\"fire at 72RPM\")) * ($quantum[primaries-pulse-rifle-revision-zero-2-burst].timing.fireRateRpm / 60) * $quantum[primaries-pulse-rifle-revision-zero-2-burst].precisionDamage / $clarity[Hunter's Trace](\"deal 1833\")",
            "note": "the primary does not fire while reload is held: per sniper round (60 / 72 s) it loses its bullets of that time (rpm / 60 per second, precision damage each); the loss is taken from the sniper round"
          },
          "intervalMs": {
            "expr": "60 / $clarity[Hunter's Trace](\"fire at 72RPM\") * 1000",
            "note": "rounds per minute to the milliseconds between two rounds"
          }
        },
        {
          "type": "spawn",
          "part": "shockwave",
          "count": "$clarity[Hunter's Trace](\"Maximum of 4 charges\")",
          "intervalMs": {
            "expr": "60 / $clarity[Hunter's Trace](\"fire at 72RPM\") * 1000",
            "note": "every sniper round trigger a shockwave"
          }
        }
      ],
      "source": {
        "name": "Item file revision-zero",
        "retrieved": "2026-11-06",
        "status": "derived",
        "quote": "Hold [Reload] to convert each fully charged stack of Targeting Data into a precision sniper round",
        "note": "Derived: the best play converts all 4 charges at once (4 sniper rounds); the primary does not fire while reload is held (3.3 s for 4 rounds at 72 RPM): its lost damage is taken off the sniper rounds as a factor (the engine has no lock of the weapon)"
      }
