        { "type": "modifyStat", "modifier": { "type": "stat", "stat": "rpm", "value": "$quantum[primaries-submachine-gun-tarrabah-ravenous-beast].timing.fireRateRpm" }, "durationMs": { "expr": "$clarity[Ravenous Beast](\"benefits for 8 seconds\") * 1000 / (1 - $clarity[Bottomless Appetite](\"duration by 0.05\") * $quantum[primaries-submachine-gun-tarrabah-ravenous-beast].timing.magazine / ($quantum[primaries-submachine-gun-tarrabah-ravenous-beast].timing.magazine * 60 / $quantum[primaries-submachine-gun-tarrabah-ravenous-beast].timing.fireRateRpm + $quantum[primaries-submachine-gun-tarrabah-ravenous-beast].timing.reloadTimeMs / 1000))", "note": "as the mode beast" } },
        { "type": "modifyStat", "modifier": { "type": "stat", "stat": "reloadMs", "value": "$quantum[primaries-submachine-gun-tarrabah-ravenous-beast].timing.reloadTimeMs" }, "durationMs": { "expr": "$clarity[Ravenous Beast](\"benefits for 8 seconds\") * 1000 / (1 - $clarity[Bottomless Appetite](\"duration by 0.05\") * $quantum[primaries-submachine-gun-tarrabah-ravenous-beast].timing.magazine / ($quantum[primaries-submachine-gun-tarrabah-ravenous-beast].timing.magazine * 60 / $quantum[primaries-submachine-gun-tarrabah-ravenous-beast].timing.fireRateRpm + $quantum[primaries-submachine-gun-tarrabah-ravenous-beast].timing.reloadTimeMs / 1000))", "note": "as the mode beast" } }
