        "status": "derived",
        "quote": "Deals 50% less damage than Legendary Trace Rifles.",
        "note": "Derived: Quantum's hit already holds the frame"
      }
    },
    {
      "id": "penance",
      "on": { "on": "phaseStart" },
      "do": [
        {
          "type": "spawn",
          "part": "penance",
          "delayMs": {
            "expr": "$clarity[Penance](\"for 3.75 seconds\") * 1000",
            "note": "the first burst after the cage stood for 3.75 s, seconds to milliseconds"
          },
          "count": {
            "expr": "($quantum[specials-trace-rifle-divinity-base-damage-no-buffs].timeToEmptySeconds - $clarity[Penance](\"for 3.75 seconds\")) / $clarity[Penance](\"Timer increases to 3 seconds\")",
            "note": "bursts while the weapon fires (its time to empty after the first one), one every 3 s"
          },
          "intervalMs": {
            "expr": "$clarity[Penance](\"Timer increases to 3 seconds\") * 1000",
            "note": "seconds to milliseconds"
          }
        }
      ],
      "source": {
        "name": "Item file divinity",
        "retrieved": "2026-11-03",
        "status": "derived",
        "quote": "Maintaining the cage does not require continuous fire.",
        "note": "Derived: the cage stands while the weapon fires; the first burst at 3.75 s, then every 3 s until the magazines are empty"
      }
    },
    {
      "id": "precision-count",
      "on": { "on": "hit", "part": "shot", "precision": true },
      "if": [
        { "type": "hasItem", "id": "catalyst" },
        {
          "type": "counter",
          "id": "precision",
          "op": "<",
          "value": "$clarity[Divinity Catalyst](\"Scoring 68 Precision Hits\")"
        }
      ],
      "do": [{ "type": "addStacks", "counter": "precision" }]
    },
    {
      "id": "focused-fury",
      "on": { "on": "hit", "part": "shot", "precision": true },
      "if": [
        { "type": "hasItem", "id": "catalyst" },
        {
          "type": "counter",
          "id": "precision",
          "op": "=",
          "value": "$clarity[Divinity Catalyst](\"Scoring 68 Precision Hits\")"
        }
      ],
      "do": [
        { "type": "resetCounter", "counter": "precision" },
        { "type": "grantBuff", "buff": "focused-fury" }
      ]
    },
    {
      "id": "jolt-count",
      "on": { "on": "hit", "part": "shot" },
      "if": [
        { "type": "hasItem", "id": "catalyst" },
        {
          "type": "counter",
          "id": "jolting-feedback",
          "op": "<",
          "value": "$clarity[Divinity Catalyst](\"Scoring 18 hits\")"
        }
      ],
      "do": [{ "type": "addStacks", "counter": "jolting-feedback" }]
    },
    {
      "id": "jolt",
      "on": { "on": "hit", "part": "shot" },
      "if": [
        { "type": "hasItem", "id": "catalyst" },
        {
          "type": "counter",
          "id": "jolting-feedback",
          "op": "=",
          "value": "$clarity[Divinity Catalyst](\"Scoring 18 hits\")"
        }
      ],
      "do": [
        { "type": "resetCounter", "counter": "jolting-feedback" },
        { "type": "applyStatus", "status": "jolt" }
      ]
    }
  ],
