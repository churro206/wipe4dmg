  },
  "parts": {
    "shot": {
      "name": "Shot",
      "damage": {
        "expr": "$quantum[specials-trace-rifle-divinity-base-damage-no-buffs].precisionDamage * (1 + $clarity[Judgment](\"30% for Divinity\") / 100)",
        "note": "Quantum's precision hit times the Vex Cage's bonus for Divinity (Quantum's row \"with Judgement\" has 20)"
      },
      "precision": true,
      "delivery": "impact"
    },
    "penance": {
      "name": "Penance",
      "damage": "$clarity[Penance](\"burst of 1060\")",
      "delivery": "splash"
    }
  },
  "buffs": [
    {
