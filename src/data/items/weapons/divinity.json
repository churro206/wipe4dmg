      "name": "Focused Fury",
      "modifiers": [
        {
          "type": "multiplier",
          "bucketId": "weaponPerk",
          "multiplier": {
            "expr": "1 + $clarity[Divinity Catalyst](\"grants 25% increased damage\") / 100",
            "note": "percent to factor"
          },
          "damageSources": ["weapon"]
        }
      ],
      "durationMs": {
        "expr": "$clarity[Divinity Catalyst](\"for 11 seconds\") * 1000",
        "note": "seconds to milliseconds"
      }
    }
  ],
  "rules": [
    {
      "id": "shot",
