    },
    "shot-hitscan-mode": {
      "name": "Hitscan, 5 rounds",
      "damage": {
        "expr": "$aegisSustained[choir-of-one-hitscan-mode-precision].base * $clarity[Fanatical Lance](\"consumes 5 ammo\")",
        "note": "one hitscan round per ammo; a shot of the item is the 5 ammo of a projectile"
      },
      "delivery": "impact"
    }
  },
  "rules": [
    {
      "id": "shot",
      "on": { "on": "shot" },
      "if": [{ "type": "playstyle", "id": "hitscan-mode", "not": true }],
      "do": [{ "type": "spawn", "part": "shot" }]
    },
    {
      "id": "shot-hitscan-mode",
      "on": { "on": "shot" },
      "if": [{ "type": "playstyle", "id": "hitscan-mode" }],
      "do": [{ "type": "spawn", "part": "shot-hitscan-mode" }]
    },
    {
      "id": "rate-hitscan-mode",
      "on": { "on": "phaseStart" },
      "if": [{ "type": "playstyle", "id": "hitscan-mode" }],
      "do": [
        {
          "type": "modifyStat",
          "modifier": {
            "type": "stat",
            "stat": "rpm",
            "value": {
              "expr": "60 / ($clarity[Fanatical Lance](\"consumes 5 ammo\") * ($aegisSustained[choir-of-one-hitscan-mode-precision].timeToEmptySeconds - ($aegisSustained[choir-of-one-hitscan-mode-precision].shots / $quantum[specials-auto-rifle-choir-of-one].magazine - 1) * $aegisSustained[choir-of-one-hitscan-mode-precision].reloadMs / 1000) / ($aegisSustained[choir-of-one-hitscan-mode-precision].shots - $aegisSustained[choir-of-one-hitscan-mode-precision].shots / $quantum[specials-auto-rifle-choir-of-one].magazine))",
              "note": "as the base rate, from the hitscan row: one round per ammo, so five rounds (the magazine of 5 shots) per shot; the slower ADS rate is inside the time to empty"
            }
          }
        }
      ]
    }
  ]
}
