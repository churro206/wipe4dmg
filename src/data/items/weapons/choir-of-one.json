  "fireRateRpm": {
    "expr": "60 / ($clarity[Fanatical Lance](\"consumes 5 ammo\") * ($aegisSustained[choir-of-one-projectile-mode-spaced].timeToEmptySeconds - ($aegisSustained[choir-of-one-projectile-mode-spaced].shots / $quantum[specials-auto-rifle-choir-of-one].magazine - 1) * $aegisSustained[choir-of-one-projectile-mode-spaced].reloadMs / 1000) / ($aegisSustained[choir-of-one-projectile-mode-spaced].shots - $aegisSustained[choir-of-one-projectile-mode-spaced].shots / $quantum[specials-auto-rifle-choir-of-one].magazine))",
    "note": "seconds per projectile to projectiles per minute: the time to empty without the reloads, over the intervals of ammo within the magazines (ADR 0013), times the 5 ammo of a projectile"
  },
  "magazine": {
    "expr": "$quantum[specials-auto-rifle-choir-of-one].magazine / $clarity[Fanatical Lance](\"consumes 5 ammo\")",
    "note": "ammo of the magazine to projectiles, 5 ammo each (Clarity)"
  },
  "totalShots": {
    "expr": "$aegisSustained[choir-of-one-projectile-mode-spaced].shots / $clarity[Fanatical Lance](\"consumes 5 ammo\")",
    "note": "ammo of the row to projectiles, 5 ammo each (Clarity)"
  },
  "reloadTimeMs": {
    "expr": "$aegisSustained[choir-of-one-projectile-mode-spaced].reloadMs - 1000 * $clarity[Fanatical Lance](\"consumes 5 ammo\") * ($aegisSustained[choir-of-one-projectile-mode-spaced].timeToEmptySeconds - ($aegisSustained[choir-of-one-projectile-mode-spaced].shots / $quantum[specials-auto-rifle-choir-of-one].magazine - 1) * $aegisSustained[choir-of-one-projectile-mode-spaced].reloadMs / 1000) / ($aegisSustained[choir-of-one-projectile-mode-spaced].shots - $aegisSustained[choir-of-one-projectile-mode-spaced].shots / $quantum[specials-auto-rifle-choir-of-one].magazine)",
    "note": "Aegis reloads right after the last shot, the simulator waits one interval first, so one interval less"
  },
  "catalyst": {
    "name": "Refit",
    "description": "One of three Refits to choose: Subsistence (Weapon Kills refill the magazine from reserves), Destabilizing Rounds (Weapon Kills apply Volatile around the target and grant Volatile Rounds), Onslaught (Weapon Kills grant stacks of Onslaught). All need Weapon Kills; against a boss without adds there is no effect.",
    "effect": "none"
  },
  "playstyles": [
    { "id": "projectile-mode", "label": "Projectile mode" },
