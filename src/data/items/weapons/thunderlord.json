{
  "id": "thunderlord",
  "kind": "exoticWeapon",
  "name": "Thunderlord",
  "texts": [
    { "source": "clarity", "entry": "Lightning Rounds", "hash": "afd91164" },
    {
      "source": "clarity",
      "entry": "Thunderlord Catalyst",
