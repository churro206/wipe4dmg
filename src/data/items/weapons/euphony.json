{
  "id": "euphony",
  "kind": "exoticWeapon",
  "name": "Euphony",
  "texts": [
    { "source": "clarity", "entry": "Spindle", "hash": "0c4ff801" },
    { "source": "clarity", "entry": "Euphony Catalyst", "hash": "7ba89029" },
    { "source": "clarity", "entry": "Unwound", "hash": "0ac6307a" }
  ],
  "chargeTimeMs": "$manifest[Euphony].stat(\"Charge Time\")",
  "fireRateRpm": "$quantum[specials-linear-fusion-rifle-euphony].timing.fireRateRpm",
  "magazine": "$quantum[specials-linear-fusion-rifle-euphony].timing.magazine",
  "totalShots": "$quantum[specials-linear-fusion-rifle-euphony].timing.totalShots",
  "reloadTimeMs": "$quantum[specials-linear-fusion-rifle-euphony].timing.reloadTimeMs",
  "catalyst": {
    "name": "Enlightened Action, Euphony Catalyst",
    "description": "Weapon Hits grant Stacks of Enlightened Action for 2 seconds. Maximum of 12 Stacks.\nStat bonuses at 1|2|…|12 Stacks:\n2|7|12|15|20|25|30|35|38|40|45|50 Handling and Reload Speed\nStacks granted per hit by Weapon Type:\n• Hand Cannons: 3 Stacks\n• Bows: ? Stacks\n• Automatic Weapons: 1 Stack",
    "effect": "unknown"
  },
  "parts": {
    "shot": {
      "name": "Shot",
      "damage": "$quantum[specials-linear-fusion-rifle-euphony].precisionDamage",
      "precision": true,
      "delivery": "impact"
    },
    "threadling": {
      "name": "Threadling",
      "damage": {
        "expr": "($quantum[specials-linear-fusion-rifle-euphony-2].magDamage - $quantum[specials-linear-fusion-rifle-euphony].magDamage) / ($quantum[specials-linear-fusion-rifle-euphony].magazine * $compendium[Euphony](\"Fires a 3-round burst\") / $clarity[Unwound](\"Landing 6 hits\") * $compendium[Euphony](\"spawns 3 Threadlings\"))",
        "note": "Quantum's magazine of 'with Threadlings' (they detonate instantly) minus 'without', shared by the Threadlings of one magazine: a shot is a burst of 3 hits (Compendium), so a magazine of 6 shots is 18 hits, 3 sets of 3 Threadlings (475 each)"
      },
      "delivery": "splash"
    }
  },
  "buffs": [
    {
      "id": "spindle",
      "name": "Spindle",
      "modifiers": [
        {
          "type": "multiplier",
          "bucketId": "weaponPerk",
          "multiplier": {
            "expr": "1 + $clarity[Spindle](\"2% Increased Damage\") / 100",
            "note": "percent to factor, per stack (perStack)"
          },
          "damageSources": ["weapon"],
          "perStack": true
        }
      ],
      "durationMs": {
        "expr": "$compendium[Euphony](\"stacks for 10 seconds\") * 1000",
        "note": "seconds to milliseconds"
      },
      "maxStacks": "$clarity[Spindle](\"Maximum of 25 stacks\")"
    }
  ],
  "rules": [
    {
      "id": "shot",
      "on": { "on": "shot" },
      "do": [{ "type": "spawn", "part": "shot" }]
    },
    {
      "id": "threadling-count",
      "on": { "on": "hit", "part": "shot" },
      "if": [
        {
          "type": "counter",
          "id": "unwound",
          "op": "<",
          "value": {
            "expr": "$clarity[Unwound](\"Landing 6 hits\") - $compendium[Euphony](\"Fires a 3-round burst\")",
            "note": "the counter stands at 0 for the shot before the one with the 6th hit (rules see the state before the shot)"
          }
        }
      ],
      "do": [
        {
          "type": "addStacks",
          "counter": "unwound",
          "by": {
            "expr": "$compendium[Euphony](\"Fires a 3-round burst\")",
            "note": "a shot is a burst of 3 hits"
          }
        }
      ]
    },
    {
      "id": "threadlings",
      "on": { "on": "hit", "part": "shot" },
      "if": [
        {
          "type": "counter",
          "id": "unwound",
          "op": ">=",
          "value": {
            "expr": "$clarity[Unwound](\"Landing 6 hits\") - $compendium[Euphony](\"Fires a 3-round burst\")",
            "note": "the shot with the 6th hit (every 2nd shot)"
          }
        }
      ],
      "do": [
        { "type": "resetCounter", "counter": "unwound" },
        {
          "type": "spawn",
          "part": "threadling",
          "count": "$compendium[Euphony](\"spawns 3 Threadlings\")"
        }
      ]
    },
    {
      "id": "spindle-refresh",
      "on": { "on": "hit", "part": "shot" },
      "if": [{ "type": "buff", "id": "spindle" }],
      "do": [
        {
          "type": "addStacks",
          "buff": "spindle",
          "by": {
            "value": 0,
            "source": {
              "name": "Item file euphony",
              "retrieved": "2026-11-03",
              "status": "derived",
              "note": "Derived: Clarity Spindle \"Weapon hits refresh this buff\" - a refresh brings no stack"
            }
          }
        }
      ]
    },
    {
      "id": "spindle-add",
      "on": { "on": "hit", "part": "threadling" },
      "if": [{ "type": "buff", "id": "spindle" }],
      "do": [{ "type": "addStacks", "buff": "spindle" }]
    },
    {
      "id": "spindle-start",
      "on": { "on": "hit", "part": "threadling" },
      "if": [{ "type": "buff", "id": "spindle", "not": true }],
      "do": [{ "type": "grantBuff", "buff": "spindle" }]
    }
  ],
  "notModelled": [
    { "quote": "Maximum of 12 Stacks", "reason": "no damage against a boss (Handling and Reload Speed, catalyst)" },
    { "quote": "Stat bonuses at 1", "reason": "no damage against a boss (Handling and Reload Speed, catalyst)" },
    { "quote": "2|7|12|15|20|25|30|35|38|40|45|50 Handling and Reload Speed", "reason": "no damage against a boss (Handling and Reload Speed, catalyst)" },
    { "quote": "Hand Cannons: 3 Stacks", "reason": "not a linear fusion rifle (stacks per weapon type of the catalyst)" },
    { "quote": "Automatic Weapons: 1 Stack", "reason": "not a linear fusion rifle (stacks per weapon type of the catalyst)" },
    {
      "quote": "Precision Kills spawn one Threadling",
      "reason": "no adds (ADR 0015)"
    },
    {
      "quote": "within 3? seconds of each other",
      "reason": "below 2 % (the window of 3 s is not met at the pace of one shot per 1.4 s only after the reload; Quantum's rows count 6 hits per magazine)"
    },
    { "quote": "? Handling", "reason": "no damage against a boss" },
    { "quote": "? Reload Speed", "reason": "no damage against a boss (Quantum's reload time stays)" },
    {
      "quote": "Weapon Hits grant Stacks of Enlightened Action for 2 seconds",
      "reason": "no damage against a boss (Handling and Reload Speed, catalyst)"
    }
  ]
}
