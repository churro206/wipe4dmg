      "name": "Grenade",
      "damage": {
        "expr": "($quantum[primaries-auto-rifle-quicksilver-storm].magDamage - $quantum[primaries-auto-rifle-quicksilver-storm].magazine * $quantum[primaries-auto-rifle-quicksilver-storm].precisionDamage) / 3 * $clarity[Grenade Chaser](\"Grenades deal 1,308\") / $clarity[Missile Tracers](\"deal 160\")",
        "note": "Quantum's missile (see there) carried to the grenade by the ratio of both Clarity numbers (1308 / 160)"
