    "missile": {
      "name": "Tracking Missile",
      "damage": {
        "expr": "($quantum[primaries-auto-rifle-quicksilver-storm].magDamage - $quantum[primaries-auto-rifle-quicksilver-storm].magazine * $quantum[primaries-auto-rifle-quicksilver-storm].precisionDamage) / 3",
