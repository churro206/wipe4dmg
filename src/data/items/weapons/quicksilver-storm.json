  "rules": [
    {
      "id": "shot",
      "on": { "on": "shot" },
      "do": [{ "type": "spawn", "part": "shot" }]
    },
    {
      "id": "tracers-count",
      "on": { "on": "hit", "part": "shot" },
      "if": [
        {
          "type": "counter",
          "id": "tracers",
          "op": "<",
          "value": {
            "expr": "$clarity[Missile Tracers](\"Scoring 13 Hits\") - 1",
            "note": "the counter stands at 0 to 11 for the hits before the 13th"
          }
        }
      ],
      "do": [{ "type": "addStacks", "counter": "tracers" }]
    },
    {
      "id": "tracers-missile",
      "on": { "on": "hit", "part": "shot" },
      "if": [
        {
          "type": "counter",
          "id": "tracers",
          "op": "=",
          "value": {
            "expr": "$clarity[Missile Tracers](\"Scoring 13 Hits\") - 1",
            "note": "the 13th hit"
          }
        }
      ],
      "do": [
        { "type": "resetCounter", "counter": "tracers" },
        { "type": "spawn", "part": "missile" }
      ]
    },
    {
      "id": "grenades-prepped",
      "on": { "on": "hit", "part": "missile" },
      "if": [{ "type": "playstyle", "id": "Grenades Prepped" }],
      "do": [{ "type": "spawn", "part": "grenade" }],
      "source": {
        "name": "Item file quicksilver-storm",
        "retrieved": "2026-11-04",
        "status": "derived",
        "note": "Derived: Aegis' assumption \"Grenades Prepped\"; every missile hit prepares one grenade, fired at once (the time of the mode change is not counted), the stack limit of 3 is met by the reload"
      }
    }
  ],
