      },
      "delivery": "splash"
    },
    "shot-cata": {
      "name": "Shot (Vorpal Weapon)",
      "damage": "$quantum[primaries-hand-cannon-malfeasance-cata].precisionDamage",
      "precision": true,
      "delivery": "impact"
    },
    "slug-cata": {
      "name": "Explosive Slug (Vorpal Weapon)",
      "damage": {
        "expr": "($quantum[primaries-hand-cannon-malfeasance-cata].magDamage - $quantum[primaries-hand-cannon-malfeasance-cata].magazine * $quantum[primaries-hand-cannon-malfeasance-cata].precisionDamage) / $quantum[primaries-hand-cannon-malfeasance-cata].magazine",
        "note": "the same from Quantum's row \"cata\" (Vorpal Weapon +20 % for primaries)"
      },
      "delivery": "splash"
    }
  },
  "rules": [
    {
      "id": "shot",
      "on": { "on": "shot" },
      "if": [{ "type": "hasItem", "id": "catalyst", "not": true }],
      "do": [{ "type": "spawn", "part": "shot" }]
    },
    {
      "id": "shot-catalyst",
      "on": { "on": "shot" },
      "if": [{ "type": "hasItem", "id": "catalyst" }],
      "do": [{ "type": "spawn", "part": "shot-cata" }]
    },
    {
      "id": "slug-count",
      "on": { "on": "hit", "part": "shot" },
      "if": [
        {
          "type": "counter",
          "id": "slugs",
          "op": "<",
          "value": {
            "expr": "$compendium[Malfeasance](\"Embedding 5 slugs\") - 1",
            "note": "the counter stands at 0 to 3 for the slugs before the 5th"
          }
        }
      ],
      "do": [{ "type": "addStacks", "counter": "slugs" }]
    },
    {
      "id": "slug-count-catalyst",
      "on": { "on": "hit", "part": "shot-cata" },
      "if": [
        {
          "type": "counter",
          "id": "slugs",
          "op": "<",
          "value": {
            "expr": "$compendium[Malfeasance](\"Embedding 5 slugs\") - 1",
            "note": "the counter stands at 0 to 3 for the slugs before the 5th"
          }
        }
      ],
      "do": [{ "type": "addStacks", "counter": "slugs" }]
    },
    {
      "id": "slugs-explode",
      "on": { "on": "hit", "part": "shot" },
      "if": [
        {
          "type": "counter",
          "id": "slugs",
          "op": "=",
          "value": {
            "expr": "$compendium[Malfeasance](\"Embedding 5 slugs\") - 1",
            "note": "the 5th slug"
          }
        }
      ],
      "do": [
        { "type": "resetCounter", "counter": "slugs" },
        {
          "type": "spawn",
          "part": "slug",
          "count": "$compendium[Malfeasance](\"Embedding 5 slugs\")"
        }
      ]
    },
    {
      "id": "slugs-explode-catalyst",
      "on": { "on": "hit", "part": "shot-cata" },
      "if": [
        {
          "type": "counter",
          "id": "slugs",
          "op": "=",
          "value": {
            "expr": "$compendium[Malfeasance](\"Embedding 5 slugs\") - 1",
            "note": "the 5th slug"
          }
        }
      ],
      "do": [
        { "type": "resetCounter", "counter": "slugs" },
        {
          "type": "spawn",
          "part": "slug-cata",
          "count": "$compendium[Malfeasance](\"Embedding 5 slugs\")"
        }
      ]
    }
  ],
