    },
    "slug": {
      "name": "Explosive Slug",
      "damage": {
        "expr": "($quantum[primaries-hand-cannon-malfeasance].magDamage - $quantum[primaries-hand-cannon-malfeasance].magazine * $quantum[primaries-hand-cannon-malfeasance].precisionDamage) / $quantum[primaries-hand-cannon-malfeasance].magazine",
