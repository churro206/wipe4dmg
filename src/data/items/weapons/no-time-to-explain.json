      "if": [
        {
          "type": "counter",
          "id": "rewind-again",
          "op": ">=",
          "value": "$clarity[Time-Slip](\"Maximum of 10 stacks\")"
        },
        { "type": "hasItem", "id": "catalyst", "not": true }
      ],
      "do": [{ "type": "spawn", "part": "portal" }],
      "source": {
        "name": "Item file no-time-to-explain",
        "retrieved": "2026-11-11",
        "status": "derived",
        "quote": "At 10 stacks, summon a 'Time-Slip Portal'",
        "note": "Derived: the portal comes with the 10th precision hit and fires as long as the weapon fires (it goes with a stow); its bursts are spread evenly over the shots"
      }
    },
    {
      "id": "portal-catalyst",
      "on": { "on": "shot" },
      "if": [
        {
          "type": "counter",
          "id": "rewind-again",
          "op": ">=",
          "value": "$clarity[Time-Slip](\"Maximum of 10 stacks\")"
        },
        { "type": "hasItem", "id": "catalyst" }
      ],
      "do": [{ "type": "spawn", "part": "portal-catalyst" }]
    }
