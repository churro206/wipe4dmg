    {
      "id": "rewind-again-no-reload",
      "on": { "on": "phaseStart" },
      "do": [
        {
          "type": "modifyStat",
          "modifier": {
            "type": "stat",
            "stat": "reload",
            "factor": {
              "value": 0,
              "source": {
                "name": "Item file no-time-to-explain",
