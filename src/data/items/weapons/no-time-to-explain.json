                "note": "Derived: every shot is a precision hit (optimal play) and refills the round it used, so the magazine never runs empty and the weapon is never reloaded"
              }
            }
          }
        }
      ]
    },
    {
      "id": "time-slip-count",
      "on": { "on": "shot" },
      "if": [
        {
          "type": "counter",
          "id": "rewind-again",
          "op": "<",
          "value": "$clarity[Time-Slip](\"Maximum of 10 stacks\")"
