{
  "name": "wipe4dmg",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:quiet": "vitest run --reporter=dot --silent",
    "sanity": "vitest run tests/plausibility.test.ts --silent=false",
    "coverage": "vitest run tests/coverage.test.ts tests/aegisCoverage.test.ts tests/coverageCatalog.test.ts --update",
    "probe": "vitest run tests/metaProbe.test.ts tests/metaProbeAuto.test.ts --update",
    "import:totals": "node scripts/import-aegis-totals.ts",
    "import:bosses": "node scripts/import-aegis-bosses.ts",
    "import:abilities": "node scripts/import-aegis-abilities.ts",
    "import:compendium": "node scripts/import-compendium.ts",
    "import:weapons": "node scripts/import-weapons.ts",
    "import:reload": "node scripts/import-reload-formulas.ts",
    "facts": "node scripts/facts.ts",
    "import:court": "node scripts/import-court.ts",
    "build:weapons": "node scripts/build-weapons.ts",
    "build:armor": "node scripts/build-armor.ts",
    "build:buffs": "node scripts/build-buffs.ts",
    "build:artifacts": "node scripts/build-artifacts.ts",
    "build:energy": "node scripts/build-energy.ts",
    "build:keywords": "node scripts/build-keywords.ts",
    "build:abilities": "node scripts/build-abilities.ts",
    "build:grants": "node scripts/build-grants.ts",
    "build:uptime": "node scripts/build-uptime.ts",
    "check:text": "node scripts/build-text-check.ts",
    "import:icons": "node --max-old-space-size=4096 --env-file-if-exists=.env.local scripts/import-bungie-icons.ts"
  },
  "dependencies": {
    "@fontsource/instrument-sans": "5.3.0",
    "marked": "^18.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
